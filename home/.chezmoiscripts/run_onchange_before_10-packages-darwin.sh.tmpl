{{ if eq .profile "mac" -}}
#!/usr/bin/env bash
# Installe les paquets Homebrew / casks / App Store listés dans .chezmoidata/packages.yaml.
# Relancé automatiquement quand cette liste change.
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Installation de Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "==> Formules Homebrew"
brew bundle --file=- <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
EOF

# Les casks sont installés un par un avec --adopt : une app déjà présente
# dans /Applications (installée à la main) est reprise par Homebrew au lieu d'échouer.
echo "==> Applications (casks)"
installed_casks="$(brew list --cask)"
{{ range .packages.darwin.casks -}}
grep -qx {{ . | quote }} <<<"$installed_casks" || brew install --cask --adopt {{ . | quote }} || echo "⚠️  cask {{ . }} non installé"
{{ end }}

if command -v npm >/dev/null 2>&1; then
  echo "==> Paquets npm globaux"
  npm install -g {{ .packages.darwin.npm | join " " }}
fi

brew cleanup
{{ end -}}
